// 1. 时钟 (Bank 2, 3.3V)
IO_LOC "clk_50m" M19;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33;

// 2. 按键与复位 (Bank 3, 必须 1.5V)
IO_LOC "key_forward_n" T18;
IO_PORT "key_forward_n" IO_TYPE=LVCMOS15;
IO_LOC "key_reverse_n" R18;
IO_PORT "key_reverse_n" IO_TYPE=LVCMOS15;
IO_LOC "reset_n" T20;
IO_PORT "reset_n" IO_TYPE=LVCMOS15;

// 3. LED指示灯 (Bank 3, 必须 1.5V)
IO_LOC "led[0]" U18;
IO_PORT "led[0]" IO_TYPE=LVCMOS15 DRIVE=8;
IO_LOC "led[1]" U19;
IO_PORT "led[1]" IO_TYPE=LVCMOS15 DRIVE=8;
IO_LOC "led[2]" U17;
IO_PORT "led[2]" IO_TYPE=LVCMOS15 DRIVE=8;
IO_LOC "led[3]" T17;
IO_PORT "led[3]" IO_TYPE=LVCMOS15 DRIVE=8;

// 4. 串口通信 (保留，用于输出调试，即使不接也不影响)
IO_LOC "uart_tx" L20;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "uart_rx" K20;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;

// 5. 电机驱动 (Bank 4, 3.3V)
IO_LOC "motor_pwm" V14;
IO_PORT "motor_pwm" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "motor_in1" AA17;
IO_PORT "motor_in1" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "motor_in2" V15;
IO_PORT "motor_in2" IO_TYPE=LVCMOS33 DRIVE=8;

// 6. 编码器接口 (Bank 4, 3.3V)
IO_LOC "enc_a" Y20;
IO_PORT "enc_a" IO_TYPE=LVCMOS33;
IO_LOC "enc_b" AA20;
IO_PORT "enc_b" IO_TYPE=LVCMOS33;

// 7. 板载 ADC 接口 (Bank 2, 3.3V) - 新增！
IO_LOC "adc_clk" G18;
IO_PORT "adc_clk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "adc_oe" H20;
IO_PORT "adc_oe" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "adc_d[0]" L21;
IO_PORT "adc_d[0]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[1]" M21;
IO_PORT "adc_d[1]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[2]" J20;
IO_PORT "adc_d[2]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[3]" J19;
IO_PORT "adc_d[3]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[4]" D19;
IO_PORT "adc_d[4]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[5]" H18;
IO_PORT "adc_d[5]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[6]" H19;
IO_PORT "adc_d[6]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[7]" G19;
IO_PORT "adc_d[7]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[8]" G17;
IO_PORT "adc_d[8]" IO_TYPE=LVCMOS33;
IO_LOC "adc_d[9]" E19;
IO_PORT "adc_d[9]" IO_TYPE=LVCMOS33;
